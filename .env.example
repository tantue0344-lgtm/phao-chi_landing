# Cấu hình kết nối PostgreSQL
# Cách 1: Dùng DATABASE_URL
DATABASE_URL=

# Mật khẩu PostgreSQL dùng cho Docker Compose hoặc cấu hình kết nối riêng bên dưới
PGPASSWORD=

# Cách 2: Cấu hình từng biến riêng biệt (nếu không đặt DATABASE_URL)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGDATABASE=phao_chi
# PGSSLMODE=disable

# Cổng chạy ứng dụng
PORT=3000
# Trước khi chạy máy chủ, hãy đặt một secret ngẫu nhiên riêng dài ít nhất 32 ký tự.
JWT_SECRET=

# Không bắt buộc: chỉ đặt cả hai biến để tạo tài khoản quản trị đầu tiên trong database chưa có tài khoản.
# Mật khẩu phải có ít nhất 12 ký tự. Tài khoản hiện có sẽ không bị thay đổi.
ADMIN_USERNAME=
ADMIN_PASSWORD=
